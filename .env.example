# =====================================================================
# ShopMind 全局环境变量模板
# 复制为 .env 后按需填写： cp .env.example .env
# 核心思路：所有「值」都可切换；AI 提供方统一走 OpenAI 兼容协议 + mock 离线回退，
# 没有 API Key 也能把整条流水线跑通，填了 Key 即切真实模型。
# =====================================================================

# ------------------------- 基础设施（docker-compose 使用） -------------------------
MYSQL_HOST=localhost
# 本机有原生 mysqld 占用 3306，Docker MySQL 用 3307
MYSQL_PORT=3307
MYSQL_USER=shop
MYSQL_PASSWORD=shop_pass
MYSQL_DATABASE=shopmind
MYSQL_ROOT_PASSWORD=root_pass

# Elasticsearch 8（开发期关安全认证，见 docker-compose）
ES_URL=http://localhost:9200
ES_INDEX_PREFIX=shopmind

# Redis（语义缓存 + 任务队列 fallback）
REDIS_URL=redis://localhost:6379/0

# MinIO（对象存储：原始文件 / 知识文档 / 直播切片 / 素材产出）
# 端口避开 Windows Hyper-V 保留区间(8941-9040)，故用 19000
MINIO_ENDPOINT=localhost:19000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET=shopmind

# ------------------------- AI 提供方（OpenAI 兼容协议） -------------------------
# 全局开关：
#   mock                = 全部离线回退（无 Key 也能跑通演示）
#   openai-compatible   = 全部走真实端点（需填齐各 *_API_KEY）
#   hybrid              = 按各 *_PROVIDER 单独决定（如只填了 embedding key）
# 各模块可用 *_PROVIDER=mock|openai-compatible 单独覆盖；留空则跟随 AI_PROVIDER。
AI_PROVIDER=hybrid
LLM_PROVIDER=
EMBEDDING_PROVIDER=
RERANK_PROVIDER=

# 对话模型：DeepSeek / Qwen(DashScope 兼容模式) / SiliconFlow 任选
#   DeepSeek      : https://api.deepseek.com/v1  , model=deepseek-chat
#   Qwen(DashScope): https://dashscope.aliyuncs.com/compatible-mode/v1 , model=qwen-plus
#   SiliconFlow   : https://api.siliconflow.cn/v1 , model=Qwen/Qwen2.5-7B-Instruct
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.3

# Embedding：可选 硅基 bge-m3 / 百炼 qwen3.7-text-embedding（都输出 1024 维）
#   SiliconFlow(兼容): https://api.siliconflow.cn/v1 , model=BAAI/bge-m3
#   DashScope(兼容) : https://dashscope.aliyuncs.com/compatible-mode/v1 , model=qwen3.7-text-embedding
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3
# 向量维度：必须与上面模型真实输出一致；ES 索引 dims 用它对齐（mock 也固定 1024）
EMBEDDING_DIM=1024

# Rerank：可选 硅基 bge-reranker-v2-m3(openai-compatible) / 百炼 qwen3.7-text-rerank(dashscope 原生)
#   SiliconFlow: RERANK_PROVIDER=openai-compatible , base=https://api.siliconflow.cn/v1
#   DashScope  : RERANK_PROVIDER=dashscope , base=https://dashscope.aliyuncs.com , model=qwen3.7-text-rerank
RERANK_PROVIDER=openai-compatible
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# ------------------------- 语音（P3 直播切片） -------------------------
# mock = 用本地转写文本离线演示；aliyun/tencent = 云端录音文件识别
ASR_PROVIDER=mock
ALIYUN_ASR_ACCESS_KEY_ID=
ALIYUN_ASR_ACCESS_KEY_SECRET=
ALIYUN_ASR_APP_KEY=
TENCENT_ASR_SECRET_ID=
TENCENT_ASR_SECRET_KEY=

# ------------------------- 文生图（P4 素材生产） -------------------------
# mock = 生成占位图离线演示；dashscope = 通义万相 / 即梦
IMAGE_PROVIDER=mock
DASHSCOPE_API_KEY=
IMAGE_MODEL=wanx-v1

# ------------------------- 日志 / 其他 -------------------------
LOG_LEVEL=INFO
# 评测用 LLM 判官（复用上面的 LLM 配置即可）
